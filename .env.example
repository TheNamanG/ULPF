# =============================================================================
# ULPF Environment Configuration
# =============================================================================
# Copy to .env and fill in real values. This file is committed to the repo;
# .env is gitignored. NEVER put real secrets here (§3).
# =============================================================================

# --- Listener ---
ULPF_LISTEN_HOST=0.0.0.0
ULPF_LISTEN_PORT=514
ULPF_MAX_MESSAGE_SIZE=65536
ULPF_QUEUE_MAX_SIZE=10000

# --- DLQ Mode ---
# Options: manual | ollama | openai
ULPF_DLQ_MODE=manual

# --- Ollama (air-gapped AI) ---
ULPF_OLLAMA_HOST=http://localhost:11434
ULPF_OLLAMA_MODEL=mistral

# --- OpenAI (cloud AI) ---
ULPF_OPENAI_API_KEY=your-key-here
ULPF_OPENAI_MODEL=gpt-4o
ULPF_OPENAI_MAX_RPM=10

# --- AI Self-Healing ---
ULPF_AI_MAX_RETRIES=2

# --- Paths ---
ULPF_PARSERS_ACTIVE_DIR=parsers/active
ULPF_PARSERS_PENDING_DIR=parsers/pending
ULPF_DLQ_DIR=data/dlq
ULPF_AUDIT_LOG_PATH=data/audit.log

# --- Logging ---
ULPF_LOG_LEVEL=INFO

# --- Observability ---
ULPF_METRICS_PORT=9090

# --- Deduplication ---
ULPF_DEDUP_ENABLED=true
ULPF_DEDUP_WINDOW_SECONDS=300
